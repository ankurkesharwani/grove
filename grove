#!/bin/sh

BASE_DIR=$(cd "$(dirname "$0")" && pwd)
VENV_DIR="$BASE_DIR/venv"

if [ -x "$VENV_DIR/bin/python" ]; then
  # Run with the virtual environment's interpreter instead of activating it.
  # Activation would leak the venv's PATH into tmux sessions grove starts.
  exec "$VENV_DIR/bin/python" "$BASE_DIR/bin/main.py" "$@"
else
  echo "Python environment is not setup. Please run \`install\` first."
  exit 103
fi
