#!/bin/sh

set -eu

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
VENV_DIR="$BASE_DIR/venv"

if ! command -v python3 >/dev/null 2>&1; then
  echo "grove: python3 is required to install the local environment." >&2
  exit 1
fi

echo "Creating project-local Python environment at $VENV_DIR"
python3 -m venv "$VENV_DIR"
"$VENV_DIR/bin/python" -m pip install -r "$BASE_DIR/requirements.txt"
echo "Installation complete. Add $BASE_DIR to PATH to run grove from anywhere."
